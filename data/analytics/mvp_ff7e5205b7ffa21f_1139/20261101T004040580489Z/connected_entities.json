  "query_id": "connected_entities",
  "question": "Quelles entités ont le plus de voisins distincts dans ce graphe ?",
  "method": "cypher",
  "dataset_id": "mvp_ff7e5205b7ffa21f_1139",
  "parameters": {
    "dataset": "mvp_ff7e5205b7ffa21f_1139",
    "person": "Thomas Schäfer",
    "organization": "Google"
  },
  "cypher": "\n            MATCH (n:Entity)-[r]-(neighbor:Entity)\n            WHERE r.dataset_id = $dataset\n              AND n.entity_id <> neighbor.entity_id\n            WITH n,\n                 count(DISTINCT neighbor.entity_id) AS neighbor_count\n            RETURN n.entity_id AS entity_id,\n                   n.name AS name,\n                   n.entity_type AS entity_type,\n                   neighbor_count\n            ORDER BY neighbor_count DESC, name\n            LIMIT 20\n        ",
